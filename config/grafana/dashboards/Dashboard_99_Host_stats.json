    {
      "datasource": {
        "type": "prometheus",
        "uid": "P7A0D6631BB10B34F"
      },
      "description": "Stacked CPU time by mode; the stack adds up to 100 %. user, system, iowait and steal are measured; other = busy \u2212 (user + system + iowait + steal), i.e. nice, irq and softirq; idle = 100 \u2212 busy. RDS with Enhanced Monitoring: all modes (busy = EM cpuUtilization.total). RDS without Enhanced Monitoring: CloudWatch CPUUtilization only, shown as \"busy (no mode split)\" + idle. Supabase and ClickHouse: per-mode CPU seconds. Self-managed: no host_* series, empty.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": 180000,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisSoftMax": 100
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "rgba(128, 128, 128, 0.25)",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 15
      },
      "id": 101,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) (host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})",
          "legendFormat": "user",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) (host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})",
          "legendFormat": "system",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) (host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})",
          "legendFormat": "iowait",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) (host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})",
          "legendFormat": "steal",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "clamp_min(max by (cluster, node_name) (host_os_cpu_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} or on(cluster, node_name) (host_cpu_utilization_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} unless on(cluster, node_name) host_os_cpu_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})) - host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} - host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} - host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} - host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"}, 0)",
          "legendFormat": "other (nice, irq, softirq)",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "max by (cluster, node_name) (host_os_cpu_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} or on(cluster, node_name) (host_cpu_utilization_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} unless on(cluster, node_name) host_os_cpu_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})) unless on(cluster, node_name) (host_os_cpu_user_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_system_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_iowait_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} and on(cluster, node_name) host_os_cpu_steal_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})",
          "legendFormat": "busy (no mode split)",
          "range": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7A0D6631BB10B34F"
          },
          "editorMode": "code",
          "expr": "clamp_min(100 - max by (cluster, node_name) (host_os_cpu_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} or on(cluster, node_name) (host_cpu_utilization_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"} unless on(cluster, node_name) host_os_cpu_percent{cluster=\"$cluster_name\", node_name=\"$node_name\"})), 0)",
          "legendFormat": "idle",
          "range": true,
          "refId": "G"
        }
      ],
      "title": "CPU utilization",
      "type": "timeseries"
    },
