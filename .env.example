# PostgresAI Monitoring Stack configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Image tag (required) - specify version to use
PGAI_TAG=0.14.0

# Registry prefix (optional, default: postgresai for DockerHub)
# For GitLab Container Registry:
#   PGAI_REGISTRY=registry.gitlab.com/postgres-ai/postgres_ai
# PGAI_REGISTRY=postgresai

# Grafana admin password. Required: there is no default. `pgai mon local-install`
# generates one; set it here when you run docker compose yourself.
GF_SECURITY_ADMIN_PASSWORD=

# Required when running docker compose directly. postgresai mon local-install
# generates and preserves these automatically.
# Generate REPLICATOR_PASSWORD with: openssl rand -hex 32
# Generate PGAI_MON_TOKEN with:      openssl rand -hex 32  (at least 16 characters)
# Empty placeholders below force Docker Compose to fail fast until replaced.
REPLICATOR_PASSWORD=
# Bearer token for pgai-mon's SQL endpoint (every route but /livez). Grafana's
# Infinity datasource, the reporter and instance-jobs send it. Treat it as a
# secret: it reads every collected metric and query text.
PGAI_MON_TOKEN=

# Where pgai-mon keeps its Parquet store.
# Empty (default): the pgai_mon_data Docker volume on this host.
# s3://bucket/prefix: the bucket. Credentials come from the default AWS chain
# (the EC2 instance role on AWS); the volume then holds only the write-ahead
# log and a read cache, so the VM is disposable. The role needs s3:ListBucket
# on the bucket (limited to the prefix) and s3:GetObject / s3:PutObject /
# s3:DeleteObject on bucket/prefix/* (see terraform/aws).
# PGAI_MON_STORE=s3://my-bucket/pgai-mon/my-instance
# AWS_REGION=us-east-1

# Days of history pgai-mon keeps: metrics (default 14) and query texts
# (default 30). 0 keeps everything. Older files are deleted from the store,
# in the bucket too; monthly rollup files go once their whole month is older.
# PGAI_MON_RETENTION_DAYS=14
# PGAI_MON_TEXTS_RETENTION_DAYS=30

# pgai-mon runs as the owner of instances.yml and host-metrics/ (both 0600 /
# 0700: they hold passwords). Defaults to INSTANCE_JOBS_USER, which
# `mon local-install` writes; unset both and it runs as the image's uid 10001.
# PGAI_MON_USER=1000:1000

# Published ports bind to 127.0.0.1. pgai-mon is always 127.0.0.1:8765.
# Grafana: unset = 127.0.0.1 only; GRAFANA_BIND_HOST= (empty) or 0.0.0.0: (with
# the colon) opens port 3000 to the network; put TLS and a real admin password
# in front of it first.
# GRAFANA_BIND_HOST=127.0.0.1:
# GRAFANA_SCALE=0 leaves Grafana out; pgai-mon, the reporter and instance-jobs
# do not need it.
# GRAFANA_SCALE=1

# === Monitoring stack resource tuning (issue #176) ===
# All variables in this section are OPTIONAL. Memory limits sum to about
# 4 GiB without the demo databases; they are caps, not reservations.
# Provisioning playbooks (Ansible / console) can export prod-grade values per VM size class without forking the compose
# file. Memory limits are in bytes (matches the convention from MR !238 /
# !248); CPUs are floats (Docker compose `cpus:` semantics).

# Demo target database (target-db)
# TARGET_DB_CPUS=0.2
# TARGET_DB_MEM=805306368              # 768 MiB

# Demo target standby (target-standby)
# TARGET_STANDBY_CPUS=0.2
# TARGET_STANDBY_MEM=805306368         # 768 MiB

# pgai-mon (collector, store, SQL endpoint)
# PGAI_MON_CPUS=1.0
# PGAI_MON_MEM=1610612736              # 1.5 GiB

# Grafana
# GRAFANA_CPUS=0.5
# GRAFANA_MEM=536870912                # 512 MiB

# Reporter (postgres-reports)
# POSTGRES_REPORTS_CPUS=1.0
# POSTGRES_REPORTS_MEM=1879048192      # 1.75 GiB

# Instance jobs (instance-jobs); only started when its compose profile is enabled.
# The profile IS this key: compose reads COMPOSE_PROFILES from .env by itself,
# so setting it here is what makes a plain `up -d` / `pull` / `down` (and every
# `postgresai mon` command) cover the container. Write it with
# `postgresai mon local-install --instance-jobs`, which merges it with any other
# profile already listed; `--no-instance-jobs` removes it and the container.
# A comma-separated list. See instance-jobs/README.md and postgresai#381.
# COMPOSE_PROFILES=instance-jobs
# INSTANCE_JOBS_CPUS=0.25
# INSTANCE_JOBS_MEM=268435456          # 256 MiB
# Relay the Supabase project's host metrics (CPU, memory, disk, network) into
# the local store and Dashboard 01. Needs the instance-jobs profile; the relay
# listens on the compose network only; `postgresai mon targets add` writes its
# scrape job while this is true. See instance-jobs/README.md.
# PGAI_SUPABASE_HOST_METRICS=true
# This instance's id. Written here by `mon local-install` when the provisioning
# flow supplies it; needed until the install writes instance_id into
# .pgwatch-config. PGAI_MONITORING_INSTANCE_ID is accepted as a second name for
# it, so this service and the telemetry one agree.
# PGAI_INSTANCE_ID=
# PGAI_MONITORING_INSTANCE_ID=
# The platform this instance reports to. Must be https unless it is loopback:
# the api key travels in a request header. Empty = production.
# PGAI_API_BASE_URL=
# Run the instance-jobs container as the owner of .pgwatch-config, which is
# 0600. `mon local-install` stats that file and writes this for you, and
# overwrites it on every re-install -- a hand-set value does not survive. With
# no value the container cannot read the credential and reports unhealthy.
# INSTANCE_JOBS_USER=1000:1000

# RDS/Aurora host stats, collected by pgai-mon itself: set the identifier to
# turn them on. Polls CloudWatch, Performance Insights and Enhanced Monitoring
# for one instance and writes host_* series for Dashboard 1's "Host" and
# "RDS DB load" rows.
# RDS_DB_INSTANCE_IDENTIFIER=
# AWS_REGION=us-east-1
# Assume a customer read-only role: set both or neither. Empty = the VM's
# default AWS credential chain.
# RDS_ROLE_ARN=
# RDS_EXTERNAL_ID=
# Seconds between polls: an integer, 1-300. Each poll bills 7 GetMetricData
# metrics (Aurora 10).
# RDS_POLL_INTERVAL_SECONDS=60
# PGAI_CLUSTER=
# PGAI_NODE_NAME=
