{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Reporter (local)",
      "type": "debugpy",
      "request": "launch",
      "module": "reporter.postgres_reports",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PGAI_MON_TOKEN": "${env:PGAI_MON_TOKEN}"
      },
      "args": [
        "--mon-url",
        "http://127.0.0.1:8765",
        "--no-upload",
        "--output",
        "-"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
