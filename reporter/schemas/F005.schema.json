{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F005 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "F005" },
    "checkTitle": { "const": "Autovacuum: index bloat (estimated)" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "bloatedIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "table_name",
        "index_name",
        "real_size",
        "table_size",
        "extra_size",
        "extra_pct",
        "bloat_size",
        "bloat_pct",
        "fillfactor",
        "last_vacuum",
        "last_vacuum_epoch",
        "real_size_pretty",
        "table_size_pretty",
        "extra_size_pretty",
        "bloat_size_pretty"
      ],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "index_name": { "type": "string" },
        "real_size": { "type": "number" },
        "table_size": { "type": "number" },
        "extra_size": { "type": "number" },
        "extra_pct": { "type": "number" },
        "bloat_size": { "type": "number" },
        "bloat_pct": { "type": "number" },
        "fillfactor": { "type": "number" },
        "last_vacuum": { "type": ["string", "null"] },
        "last_vacuum_epoch": { "type": "number" },
        "real_size_pretty": { "type": "string" },
        "table_size_pretty": { "type": "string" },
        "extra_size_pretty": { "type": "string" },
        "bloat_size_pretty": { "type": "string" },
        "bloat_size_min_in_window_bytes": { "type": ["integer", "null"] },
        "bloat_size_max_in_window_bytes": { "type": ["integer", "null"] },
        "real_size_min_in_window_bytes": { "type": ["integer", "null"] },
        "real_size_max_in_window_bytes": { "type": ["integer", "null"] },
        "on_unused_list": { "type": ["boolean", "null"] },
        "on_redundant_list": { "type": ["boolean", "null"] }
      }
    },
    "tableFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "table_name"],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "n_live_tup": { "type": ["integer", "null"] },
        "n_dead_tup": { "type": ["integer", "null"] },
        "vacuum_threshold": { "type": ["integer", "null"] },
        "autovacuum_runs_in_window": { "type": ["integer", "null"] },
        "vacuum_runs_in_window": { "type": ["integer", "null"] },
        "n_tup_ins_in_window": { "type": ["integer", "null"] },
        "n_tup_upd_in_window": { "type": ["integer", "null"] },
        "n_tup_del_in_window": { "type": ["integer", "null"] },
        "n_tup_hot_upd_in_window": { "type": ["integer", "null"] },
        "table_size_bytes": { "type": ["integer", "null"] },
        "toast_size_bytes": { "type": ["integer", "null"] },
        "table_size_min_in_window_bytes": { "type": ["integer", "null"] },
        "table_size_max_in_window_bytes": { "type": ["integer", "null"] },
        "seconds_since_last_vacuum": { "type": ["integer", "null"] },
        "vacuum_recorded": { "type": ["boolean", "null"] },
        "autovacuum_disabled": { "type": ["boolean", "null"] }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily", "first_reading_at"],
      "properties": {
        "daily": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days_ago", "at", "total_bloat_size_bytes"],
            "properties": {
              "days_ago": { "type": "integer" },
              "at": { "type": ["string", "null"] },
              "total_bloat_size_bytes": { "type": "integer" }
            }
          }
        },
        "first_reading_at": { "type": ["string", "null"] },
        "window_seconds": { "type": "integer" }
      }
    },
    "dbEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bloated_indexes",
        "total_count",
        "total_bloat_size_bytes",
        "total_bloat_size_pretty",
        "database_size_bytes",
        "database_size_pretty"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "bloated_indexes": { "type": "array", "items": { "$ref": "#/$defs/bloatedIndex" } },
        "total_count": { "type": "integer" },
        "total_bloat_size_bytes": { "type": "number" },
        "total_bloat_size_pretty": { "type": "string" },
        "database_size_bytes": { "type": "number" },
        "database_size_pretty": { "type": "string" },
        "history": { "$ref": "#/$defs/history" },
        "table_facts": { "type": "array", "items": { "$ref": "#/$defs/tableFact" } },
        "traffic_by_hour_utc": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hour", "xact_commit_per_s", "readings"],
            "properties": {
              "hour": { "type": "integer" },
              "xact_commit_per_s": { "type": "number" },
              "readings": { "type": "integer" }
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "reason", "error"],
      "properties": {
        "ok": { "type": "boolean" },
        "reason": {
          "enum": [null, "missing_schema", "missing_view", "missing_grant", "query_error"]
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dbEntry" }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" }
      }
    }
  }
}
