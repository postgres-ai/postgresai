{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D001 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "D001" },
    "checkTitle": { "const": "Logging settings" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "unit", "category", "context", "vartype", "pretty_value"],
      "properties": {
        "setting": { "type": "string" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "context": { "type": "string" },
        "vartype": { "type": "string" },
        "pretty_value": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/setting" }
    },
    "counterWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "days",
        "total"
      ],
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": "string"
        },
        "days": {
          "type": [
            "number",
            "null"
          ]
        },
        "total": {
          "type": "number"
        },
        "floor": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_as": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "database"
          ],
          "properties": {
            "role": {
              "type": "string"
            },
            "database": {
              "type": "string"
            }
          }
        },
        "setting_sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "is_default",
              "pending_restart"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "is_default": {
                "type": "boolean"
              },
              "pending_restart": {
                "type": "boolean"
              }
            }
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows_read",
            "values"
          ],
          "properties": {
            "rows_read": {
              "type": "integer"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "role",
                  "database",
                  "setting",
                  "value"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "role",
                      "database",
                      "role in database",
                      "all"
                    ]
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "setting": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "login_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "superuser",
              "member_of",
              "sessions",
              "oldest_session_start",
              "applications"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "superuser": {
                "type": "boolean"
              },
              "sessions": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "oldest_session_start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "applications": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "member_of": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "statements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thresholds_ms",
            "by_role"
          ],
          "properties": {
            "thresholds_ms": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "dealloc": {
              "type": "integer"
            },
            "stats_reset": {
              "type": [
                "string",
                "null"
              ]
            },
            "by_role": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "groups",
                  "calls",
                  "longest_call_ms",
                  "stats_since",
                  "groups_at_or_over_ms",
                  "calls_of_groups_at_or_over_ms"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "groups": {
                    "type": "integer"
                  },
                  "calls": {
                    "type": "integer"
                  },
                  "longest_call_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "stats_since": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "groups_at_or_over_ms": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  },
                  "calls_of_groups_at_or_over_ms": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "temp_files": {
          "$ref": "#/$defs/counterWindow"
        },
        "temp_bytes": {
          "$ref": "#/$defs/counterWindow"
        },
        "autovacuum_runs": {
          "$ref": "#/$defs/counterWindow"
        }
      },
      "patternProperties": {
        "_error$": {
          "type": "string"
        }
      }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "logging": { "$ref": "#/$defs/logging" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" }
      }
    }
  }
}
