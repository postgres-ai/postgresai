{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H001 report schema",
  "description": "Invalid indexes report with remediation decision tree recommendations",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "H001" },
    "checkTitle": { "const": "Invalid indexes" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "invalidIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "table_name",
        "index_name",
        "relation_name",
        "index_size_bytes",
        "index_size_pretty",
        "index_definition",
        "supports_fk",
        "is_pk",
        "is_unique",
        "constraint_name",
        "table_row_estimate",
        "has_valid_duplicate",
        "valid_duplicate_name",
        "valid_duplicate_definition"
      ],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "index_name": { "type": "string" },
        "relation_name": { "type": "string" },
        "index_size_bytes": { "type": "number" },
        "index_size_pretty": { "type": "string" },
        "index_definition": {
          "type": "string",
          "description": "Full CREATE INDEX statement from pg_get_indexdef()"
        },
        "supports_fk": { "type": "boolean" },
        "is_pk": {
          "type": "boolean",
          "description": "True if this index backs a PRIMARY KEY constraint"
        },
        "is_unique": {
          "type": "boolean",
          "description": "True if this is a UNIQUE index (includes PK indexes)"
        },
        "constraint_name": {
          "type": ["string", "null"],
          "description": "Name of the constraint this index backs, or null if none"
        },
        "table_row_estimate": {
          "type": "integer",
          "description": "Estimated row count of the table from pg_class.reltuples"
        },
        "has_valid_duplicate": {
          "type": "boolean",
          "description": "True if there is a valid index on the same column(s)"
        },
        "valid_duplicate_name": {
          "type": ["string", "null"],
          "description": "Name of the valid duplicate index if one exists"
        },
        "valid_duplicate_definition": {
          "type": ["string", "null"],
          "description": "Full CREATE INDEX statement of the valid duplicate index from pg_get_indexdef()"
        },
        "is_ready": {
          "type": "boolean",
          "description": "pg_index.indisready: false = writes do not maintain the index; absent when the box does not collect it"
        },
        "build_in_progress": {
          "type": "boolean",
          "description": "A CREATE INDEX for it is running (pg_stat_progress_create_index): not a leftover yet"
        },
        "first_seen_epoch": { "type": "number", "description": "First monitored reading in the lookback that listed it" },
        "first_seen_time": { "type": "string" },
        "last_seen_epoch": { "type": "number" },
        "last_seen_time": { "type": "string" },
        "listed_hours": { "type": "integer", "description": "Hourly steps from first_seen that listed it" },
        "reading_hours": { "type": "integer", "description": "Hourly steps from first_seen with a database-size reading" }
      }
    },
    "dbEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalid_indexes",
        "total_count",
        "total_size_bytes",
        "total_size_pretty",
        "database_size_bytes",
        "database_size_pretty"
      ],
      "properties": {
        "invalid_indexes": { "type": "array", "items": { "$ref": "#/$defs/invalidIndex" } },
        "total_count": { "type": "integer" },
        "total_size_bytes": { "type": "number" },
        "total_size_pretty": { "type": "string" },
        "database_size_bytes": { "type": "number" },
        "database_size_pretty": { "type": "string" },
        "not_valid_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_count", "constraints"],
          "description": "Constraints added NOT VALID and never validated; absent when the box does not collect them",
          "properties": {
            "total_count": { "type": "integer" },
            "constraints": { "type": "array", "items": { "$ref": "#/$defs/notValidConstraint" } }
          }
        },
        "monitoring_start_epoch": { "type": "number", "description": "First database-size reading in the lookback" },
        "monitoring_start_time": { "type": "string" }
      }
    },
    "notValidConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "table_name", "constraint_name", "constraint_type", "constraint_definition", "is_partition_copy"],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "constraint_name": { "type": "string" },
        "constraint_type": { "type": "string", "description": "c = CHECK, f = FOREIGN KEY" },
        "constraint_definition": { "type": "string" },
        "is_partition_copy": { "type": "boolean", "description": "A partition's copy of a parent's constraint" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dbEntry" }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" }
      }
    }
  }
}
