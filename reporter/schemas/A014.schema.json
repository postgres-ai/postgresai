{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A014 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkId",
    "checkTitle",
    "timestamptz",
    "nodes",
    "results"
  ],
  "properties": {
    "contract_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "message"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "build_ts": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkId": {
      "const": "A014"
    },
    "checkTitle": {
      "const": "Resource sizing"
    },
    "timestamptz": {
      "type": "string"
    },
    "nodes": {
      "$ref": "#/$defs/nodes"
    },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nodeResult"
      }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "standbys"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "standbys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "server_version_num",
        "server_major_ver",
        "server_minor_ver"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "server_version_num": {
          "type": "string"
        },
        "server_major_ver": {
          "type": "string"
        },
        "server_minor_ver": {
          "type": "string"
        }
      }
    },
    "clusterMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "description"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_hours",
        "host_metrics",
        "cpu",
        "memory",
        "disk",
        "connections",
        "db_size_bytes",
        "series"
      ],
      "properties": {
        "window_hours": {
          "type": "number",
          "minimum": 0
        },
        "host_metrics": {
          "type": "boolean"
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cores",
            "p95_pct",
            "max_pct"
          ],
          "properties": {
            "cores": {
              "type": [
                "integer",
                "null"
              ]
            },
            "p95_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "avg_pct": {
              "type": [
                "number",
                "null"
              ],
              "description": "Mean of the 5-minute CPU averages (a burstable class's baseline is an average)."
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_bytes",
            "available_min_pct",
            "available_p5_pct"
          ],
          "properties": {
            "total_bytes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "available_min_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "available_p5_pct": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mbps_p95",
            "mbps_max",
            "iops_p95",
            "iops_max",
            "free_bytes"
          ],
          "properties": {
            "mbps_p95": {
              "type": [
                "number",
                "null"
              ]
            },
            "mbps_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "iops_p95": {
              "type": [
                "number",
                "null"
              ],
              "description": "95th percentile of the 5-minute averages of read + write IOPS (Supabase: all block devices, root disk included)."
            },
            "iops_max": {
              "type": [
                "number",
                "null"
              ],
              "description": "The highest 5-minute average of read + write IOPS, not the busiest minute."
            },
            "free_bytes": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "connections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backends_p95",
            "backends_max",
            "max_connections"
          ],
          "properties": {
            "backends_p95": {
              "type": [
                "number",
                "null"
              ]
            },
            "backends_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_connections": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "db_size_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "series": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_seconds",
            "start_epoch",
            "cpu_pct",
            "mem_available_pct",
            "disk_mbps",
            "disk_iops"
          ],
          "properties": {
            "step_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "start_epoch": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cpu_pct": {
              "type": "array",
              "maxItems": 2100,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "mem_available_pct": {
              "type": "array",
              "maxItems": 2100,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "disk_mbps": {
              "type": "array",
              "maxItems": 2100,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "disk_iops": {
              "type": "array",
              "maxItems": 2100,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Read + write IOPS, each point the average over its 5 minutes."
            },
            "disk_iops_kind": {
              "type": "string",
              "enum": [
                "avg_5m"
              ],
              "description": "What a disk_iops point is: avg_5m = the 5-minute average. Reports from older reporters omit it (their points were the busiest minute), and the platform does not judge their IOPS."
            },
            "cpu_avg_pct": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "5-minute CPU averages, percent"
            },
            "mem_available_bytes": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Lowest memory available in each 5 minutes, bytes"
            },
            "cpu_credit_balance": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Lowest CPU credit balance in each 5 minutes (RDS db.t*)"
            },
            "cpu_surplus_balance": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Highest CPU surplus credit balance in each 5 minutes (RDS db.t*)"
            },
            "burst_balance_pct": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Lowest gp2 BurstBalance in each 5 minutes, percent"
            },
            "ebs_io_balance_pct": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Lowest EBSIOBalance% in each 5 minutes"
            },
            "ebs_byte_balance_pct": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Lowest EBSByteBalance% in each 5 minutes"
            }
          }
        },
        "observed_size": {
          "type": "object",
          "additionalProperties": false,
          "description": "What the database server is, for the platform's sizing (platform-all#1101). Absent when unknown.",
          "required": [
            "provider",
            "size",
            "region",
            "storage",
            "seen_at_epoch",
            "since_epoch"
          ],
          "properties": {
            "provider": {
              "enum": [
                "rds",
                "aurora",
                "clickhouse"
              ],
              "description": "Where the server runs: rds and aurora from rds-host-stats' instance info, clickhouse for a ClickHouse Managed Postgres service."
            },
            "size": {
              "type": [
                "string",
                "null"
              ],
              "description": "RDS/Aurora: the instance class (db.t4g.micro). ClickHouse: the service size from the ClickHouse Cloud API (r6gd.large); null when only its metrics are known."
            },
            "region": {
              "type": [
                "string",
                "null"
              ],
              "description": "Cloud region (eu-central-1); null when unknown."
            },
            "engine": {
              "type": [
                "string",
                "null"
              ],
              "description": "RDS/Aurora only: the DB engine (postgres, aurora-postgresql)."
            },
            "multi_az": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "RDS only: whether the instance is a Multi-AZ deployment (its compute is paid twice)."
            },
            "standbys": {
              "type": [
                "integer",
                "null"
              ],
              "description": "ClickHouse only: standby copies from the API's haType (none 0, async 1, sync 2)."
            },
            "org_tier": {
              "type": [
                "string",
                "null"
              ],
              "description": "ClickHouse only: the organization's plan (basic, scale, enterprise), lower case; it prices the size. Null when not read."
            },
            "vcpus": {
              "type": [
                "integer",
                "null"
              ],
              "description": "ClickHouse only: vCPUs from the service's metrics (PostgresServer_CPUCores)."
            },
            "memory_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "description": "ClickHouse only: memory from the service's metrics, in bytes."
            },
            "size_source": {
              "enum": [
                "api",
                "metrics"
              ],
              "description": "ClickHouse only: api when the size came from the ClickHouse Cloud API, metrics when only the metrics answered."
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "size_gb",
                "max_size_gb",
                "iops",
                "throughput_mbps"
              ],
              "properties": {
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Volume type (gp2, gp3, io1, io2; nvme for ClickHouse)."
                },
                "size_gb": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Allocated storage in GiB."
                },
                "max_size_gb": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "RDS storage autoscaling ceiling in GiB; null when autoscaling is off."
                },
                "iops": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Provisioned IOPS (RDS gp3/io1/io2); null otherwise."
                },
                "throughput_mbps": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Provisioned throughput in MB/s (decimal: 125 MiB/s is 131.1), as the platform shows it; null otherwise."
                }
              }
            },
            "seen_at_epoch": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Unix seconds of the last sample that showed this size. The platform treats a size seen more than an hour before (or after) the report as stale."
            },
            "since_epoch": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Unix seconds of the first point of the current size after another one in the 7-day window (a resize); null when the size did not change."
            }
          }
        }
      }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": "string" },
        "data": {
          "$ref": "#/$defs/data"
        },
        "postgres_version": {
          "$ref": "#/$defs/postgresVersion"
        }
      }
    }
  }
}
