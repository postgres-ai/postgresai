{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F003 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "F003" },
    "checkTitle": { "const": "Autovacuum: dead tuples" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "deadTuplesTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "table_name",
        "n_live_tup",
        "n_dead_tup",
        "dead_pct",
        "last_autovacuum",
        "last_autovacuum_epoch",
        "last_vacuum",
        "last_vacuum_epoch",
        "autovacuum_count",
        "vacuum_count",
        "autovacuum_disabled",
        "table_size_bytes",
        "table_size_pretty",
        "exceeds_dead_tuple_thresholds",
        "autovacuum_disabled_flagged"
      ],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "n_live_tup": { "type": "number" },
        "n_dead_tup": { "type": "number" },
        "dead_pct": { "type": "number" },
        "last_autovacuum": { "type": ["string", "null"] },
        "last_autovacuum_epoch": { "type": "number" },
        "last_vacuum": { "type": ["string", "null"] },
        "last_vacuum_epoch": { "type": "number" },
        "autovacuum_count": { "type": "number" },
        "vacuum_count": { "type": "number" },
        "autovacuum_disabled": { "type": "boolean" },
        "table_size_bytes": { "type": "number" },
        "table_size_pretty": { "type": "string" },
        "exceeds_dead_tuple_thresholds": { "type": "boolean" },
        "autovacuum_disabled_flagged": { "type": "boolean" },
        "reltuples": { "type": "number" },
        "relpages": { "type": "number" },
        "n_mod_since_analyze": { "type": "number" },
        "n_ins_since_vacuum": { "type": ["number", "null"] },
        "last_autoanalyze": { "type": ["string", "null"] },
        "last_autoanalyze_epoch": { "type": "number" },
        "eff_vacuum_threshold": { "type": "number" },
        "eff_vacuum_scale_factor": { "type": "number" },
        "vacuum_settings_from_reloptions": { "type": "boolean" },
        "eff_analyze_threshold": { "type": "number" },
        "eff_analyze_scale_factor": { "type": "number" },
        "eff_insert_threshold": { "type": ["number", "null"] },
        "eff_insert_scale_factor": { "type": ["number", "null"] },
        "insert_settings_from_reloptions": { "type": "boolean" },
        "vacuum_trigger_point": { "type": "number" },
        "analyze_trigger_point": { "type": "number" },
        "insert_trigger_point": { "type": ["number", "null"] },
        "over_trigger_ratio": { "type": "number" },
        "over_vacuum_trigger": { "type": "boolean" },
        "over_analyze_trigger": { "type": "boolean" },
        "over_insert_trigger": { "type": "boolean" },
        "toast_autovacuum_disabled": { "type": "boolean" },
        "starving": { "type": "boolean" }
      }
    },
    "triggerThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_k", "keepup_min_rows", "queue_saturation_multiplier", "starvation_hours"],
      "properties": {
        "top_k": { "type": "number" },
        "keepup_min_rows": { "type": "number" },
        "queue_saturation_multiplier": { "type": "number" },
        "starvation_hours": { "type": "number" }
      }
    },
    "blockedWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_pid", "blocker_pid", "blocker_queryid", "wait_seconds"],
      "properties": {
        "worker_pid": { "type": "number" },
        "blocker_pid": { "type": ["number", "null"] },
        "blocker_queryid": { "type": ["string", "null"] },
        "wait_seconds": { "type": "number" }
      }
    },
    "vacuumProgressEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "table_name",
        "vacuum_mode",
        "phase",
        "phase_code",
        "heap_blks_total",
        "heap_blks_scanned",
        "heap_blks_vacuumed",
        "index_vacuum_count",
        "is_anti_wraparound"
      ],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "vacuum_mode": { "type": "string" },
        "phase": { "type": "string" },
        "phase_code": { "type": ["number", "null"] },
        "heap_blks_total": { "type": "number" },
        "heap_blks_scanned": { "type": "number" },
        "heap_blks_vacuumed": { "type": "number" },
        "index_vacuum_count": { "type": "number" },
        "is_anti_wraparound": { "type": "boolean" }
      }
    },
    "autovacuumKeepup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relations_total",
        "candidates_considered",
        "queue_length",
        "analyze_queue_length",
        "insert_queue_length",
        "total_dead_tuples_all",
        "active_workers",
        "max_workers",
        "free_slots",
        "anti_wraparound_workers",
        "anti_wraparound_present",
        "saturated",
        "chronic_under_provisioning",
        "starving_tables_count",
        "blocked_workers",
        "vacuum_progress",
        "judgment",
        "status"
      ],
      "properties": {
        "relations_total": { "type": "number" },
        "candidates_considered": { "type": "number" },
        "queue_length": { "type": "number" },
        "analyze_queue_length": { "type": "number" },
        "insert_queue_length": { "type": ["number", "null"] },
        "total_dead_tuples_all": { "type": "number" },
        "active_workers": { "type": "number" },
        "max_workers": { "type": ["number", "null"] },
        "free_slots": { "type": ["number", "null"] },
        "anti_wraparound_workers": { "type": "number" },
        "anti_wraparound_present": { "type": "boolean" },
        "saturated": { "type": "boolean" },
        "chronic_under_provisioning": { "type": "boolean" },
        "starving_tables_count": { "type": "number" },
        "blocked_workers": { "type": "array", "items": { "$ref": "#/$defs/blockedWorker" } },
        "vacuum_progress": { "type": "array", "items": { "$ref": "#/$defs/vacuumProgressEntry" } },
        "judgment": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "warning", "critical"] }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dead_tuples_min", "dead_pct_min", "autovacuum_disabled_min_rows"],
      "properties": {
        "dead_tuples_min": { "type": "number" },
        "dead_pct_min": { "type": "number" },
        "autovacuum_disabled_min_rows": { "type": "number" }
      }
    },
    "dbEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dead_tuples_tables",
        "total_count",
        "flagged_count",
        "autovacuum_disabled_count",
        "autovacuum_disabled_flagged_count",
        "total_dead_tuples",
        "thresholds",
        "conclusions",
        "recommendations",
        "database_size_bytes",
        "database_size_pretty"
      ],
      "properties": {
        "dead_tuples_tables": { "type": "array", "items": { "$ref": "#/$defs/deadTuplesTable" } },
        "total_count": { "type": "integer" },
        "flagged_count": { "type": "integer" },
        "autovacuum_disabled_count": { "type": "integer" },
        "autovacuum_disabled_flagged_count": { "type": "integer" },
        "total_dead_tuples": { "type": "number" },
        "thresholds": { "$ref": "#/$defs/thresholds" },
        "trigger_thresholds": { "$ref": "#/$defs/triggerThresholds" },
        "autovacuum_keepup": { "$ref": "#/$defs/autovacuumKeepup" },
        "conclusions": { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "database_size_bytes": { "type": "number" },
        "database_size_pretty": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dbEntry" }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" }
      }
    }
  }
}
