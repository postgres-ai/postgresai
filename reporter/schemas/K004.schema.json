{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K004 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "K004" },
    "checkTitle": { "const": "Top queries by temp bytes written" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "timeline": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "hourlyNumbers": {
      "type": "array",
      "items": { "type": "number" }
    },
    "queryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryid", "total_temp_bytes", "hourly_temp_bytes"],
      "properties": {
        "queryid": { "type": "string" },
        "total_temp_bytes": { "type": "number" },
        "hourly_temp_bytes": { "$ref": "#/$defs/hourlyNumbers" },
        "calls": { "type": "number" },
        "exec_time_ms": { "type": "number" },
        "rows": { "type": "number" },
        "shared_blks_hit_bytes": { "type": "number" },
        "shared_blks_read_bytes": { "type": "number" },
        "wal_bytes": { "type": "number" },
        "temp_bytes_written": { "type": "number" },
        "temp_bytes_read": { "type": "number" },
        "query_text": { "type": "string" },
        "is_monitoring": { "type": "boolean" },
        "relations": { "type": "array", "items": { "type": "string" }, "maxItems": 3 }
      }
    },
    "exportRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_n_per_database", "ranked_by", "min_calls", "min_exec_time_ms", "interval_seconds"],
      "properties": {
        "top_n_per_database": { "type": "integer" },
        "ranked_by": { "type": "string" },
        "min_calls": { "type": "integer" },
        "min_exec_time_ms": { "type": "number" },
        "interval_seconds": { "type": "integer" }
      }
    },
    "counterHours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "total", "hourly"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "total": { "type": "number" },
        "hourly": { "$ref": "#/$defs/hourlyNumbers" },
        "peak_per_s": { "type": "number" },
        "peak_at": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "unit", "context"],
      "properties": {
        "setting": { "type": "string" },
        "unit": { "type": "string" },
        "context": { "type": "string" }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "role", "database", "setting", "value"],
      "properties": {
        "scope": { "type": "string" },
        "role": { "type": ["string", "null"] },
        "database": { "type": ["string", "null"] },
        "setting": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries_returned",
        "total_temp_bytes",
        "total_temp_bytes_tracked_queries",
        "total_temp_bytes_other",
        "time_range_hours",
        "hourly_timestamps",
        "limit"
      ],
      "properties": {
        "queries_returned": { "type": "integer" },
        "total_temp_bytes": { "type": "number" },
        "total_temp_bytes_tracked_queries": { "type": "number" },
        "total_temp_bytes_other": { "type": "number" },
        "time_range_hours": { "type": "integer" },
        "hourly_timestamps": { "$ref": "#/$defs/timeline" },
        "limit": { "type": "integer" },
        "window_start": { "type": "string" },
        "window_end": { "type": "string" },
        "window_seconds": { "type": "integer" },
        "export_rule": { "$ref": "#/$defs/exportRule" },
        "total_calls": { "type": "number" },
        "statements_exported_max": { "type": "integer" },
        "statements_reset_max": { "type": "integer" },
        "statements_reset_at": { "type": "string" },
        "database_temp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": { "$ref": "#/$defs/counterHours" },
            "files": { "$ref": "#/$defs/counterHours" },
            "bytes_error": { "type": "string" },
            "files_error": { "type": "string" }
          }
        }
      }
    },
    "dbEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_queries", "other_temp_bytes_hourly", "summary"],
      "properties": {
        "top_queries": { "type": "array", "items": { "$ref": "#/$defs/queryEntry" } },
        "other_temp_bytes_hourly": { "$ref": "#/$defs/hourlyNumbers" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dbEntry" }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" },
        "settings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/setting" } },
        "settings_error": { "type": "string" },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows_read", "values"],
          "properties": {
            "rows_read": { "type": "integer" },
            "values": { "type": "array", "items": { "$ref": "#/$defs/override" } }
          }
        },
        "overrides_error": { "type": "string" },
        "node_error": { "type": "string" },
        "platform_allowed": { "type": "array", "items": { "type": "string" } },
        "platform_allowed_error": { "type": "string" }
      }
    }
  }
}
