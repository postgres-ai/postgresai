{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D004 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "D004" },
    "checkTitle": { "const": "pg_stat_statements and pg_stat_kcache settings" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "unit", "category", "context", "vartype", "pretty_value"],
      "properties": {
        "setting": { "type": "string" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "context": { "type": "string" },
        "vartype": { "type": "string" },
        "pretty_value": { "type": "string" }
      }
    },
    "pgssSampleQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryid", "user", "database", "calls"],
      "properties": {
        "queryid": { "type": "string" },
        "user": { "type": "string" },
        "database": { "type": "string" },
        "calls": { "type": "number" }
      }
    },
    "pgssStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension_available", "metrics_count", "total_calls", "sample_queries"],
      "properties": {
        "extension_available": { "type": "boolean" },
        "metrics_count": { "type": "number" },
        "total_calls": { "type": "number" },
        "sample_queries": { "type": "array", "items": { "$ref": "#/$defs/pgssSampleQuery" } },
        "error": { "type": "string" }
      }
    },
    "kcacheSampleQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryid", "user", "exec_total_time"],
      "properties": {
        "queryid": { "type": "string" },
        "user": { "type": "string" },
        "exec_total_time": { "type": "number" }
      }
    },
    "kcacheStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_available",
        "metrics_count",
        "total_exec_time",
        "total_user_time",
        "total_system_time",
        "sample_queries"
      ],
      "properties": {
        "extension_available": { "type": "boolean" },
        "metrics_count": { "type": "number" },
        "total_exec_time": { "type": "number" },
        "total_user_time": { "type": "number" },
        "total_system_time": { "type": "number" },
        "sample_queries": { "type": "array", "items": { "$ref": "#/$defs/kcacheSampleQuery" } },
        "error": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "pg_stat_statements_status", "pg_stat_kcache_status"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/setting" }
        },
        "pg_stat_statements_status": { "$ref": "#/$defs/pgssStatus" },
        "pg_stat_kcache_status": { "$ref": "#/$defs/kcacheStatus" }
      }
    },
    "catalogSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "unit",
        "category",
        "context",
        "vartype",
        "source",
        "is_default",
        "pending_restart"
      ],
      "properties": {
        "setting": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "vartype": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "is_default": {
          "type": "boolean"
        },
        "pending_restart": {
          "type": "boolean"
        }
      }
    },
    "installed": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "schema"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_error": {
          "type": "string"
        },
        "read_as": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "database"
          ],
          "properties": {
            "role": {
              "type": "string"
            },
            "database": {
              "type": "string"
            }
          }
        },
        "read_as_error": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/catalogSetting"
          }
        },
        "settings_error": {
          "type": "string"
        },
        "available": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default_version"
            ],
            "properties": {
              "default_version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "available_error": {
          "type": "string"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows_read",
            "values"
          ],
          "properties": {
            "rows_read": {
              "type": "integer"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "role",
                  "database",
                  "setting",
                  "value"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "all",
                      "role",
                      "database",
                      "role in database"
                    ]
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "setting": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "overrides_error": {
          "type": "string"
        },
        "databases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "installed": {
                "$ref": "#/$defs/installed"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "statements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "entries",
            "by_database"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "database": {
              "type": "string"
            },
            "entries": {
              "type": "integer"
            },
            "by_database": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "database",
                  "entries",
                  "calls",
                  "called_once"
                ],
                "properties": {
                  "database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "entries": {
                    "type": "integer"
                  },
                  "calls": {
                    "type": "integer"
                  },
                  "called_once": {
                    "type": "integer"
                  },
                  "temp_table_text": {
                    "type": "integer"
                  }
                }
              }
            },
            "temp_table_text_error": {
              "type": "string"
            },
            "dealloc": {
              "type": "integer"
            },
            "stats_reset": {
              "type": [
                "string",
                "null"
              ]
            },
            "read_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "dealloc_error": {
              "type": "string"
            },
            "per_round_at_max": {
              "type": "integer"
            },
            "days_since_reset": {
              "type": "number"
            }
          }
        },
        "statements_error": {
          "type": "string"
        },
        "databases_error": {
          "type": "string"
        },
        "monitored_calls_window": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "days",
              "total",
              "database",
              "statements"
            ],
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "days": {
                "type": "number"
              },
              "total": {
                "type": "integer"
              },
              "database": {
                "type": "string"
              },
              "statements": {
                "type": "integer"
              }
            }
          }
        },
        "monitored_calls_window_error": {
          "type": "string"
        }
      }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "observability": { "$ref": "#/$defs/observability" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" }
      }
    }
  }
}
