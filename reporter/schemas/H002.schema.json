{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H002 report schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "checkTitle", "timestamptz", "nodes", "results"],
  "properties": {
    "contract_version": { "type": ["string", "null"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["status", "message"], "properties": { "status": { "enum": ["ok", "warning", "info"] }, "message": { "type": "string" } } },
    "version": { "type": ["string", "null"] },
    "build_ts": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "checkId": { "const": "H002" },
    "checkTitle": { "const": "Unused indexes" },
    "timestamptz": { "type": "string" },
    "nodes": { "$ref": "#/$defs/nodes" },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nodeResult" }
    }
  },
  "$defs": {
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "standbys"],
      "properties": {
        "primary": { "type": "string" },
        "standbys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postgresVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "server_version_num", "server_major_ver", "server_minor_ver"],
      "properties": {
        "version": { "type": "string" },
        "server_version_num": { "type": "string" },
        "server_major_ver": { "type": "string" },
        "server_minor_ver": { "type": "string" }
      }
    },
    "unusedIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "table_name",
        "index_name",
        "index_definition",
        "reason",
        "idx_scan",
        "index_size_bytes",
        "idx_is_btree",
        "supports_fk",
        "index_size_pretty"
      ],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "index_name": { "type": "string" },
        "index_definition": { "type": "string" },
        "reason": { "type": "string" },
        "idx_scan": { "type": "number" },
        "index_size_bytes": { "type": "number" },
        "idx_is_btree": { "type": ["boolean", "null"] },
        "supports_fk": { "type": ["boolean", "null"] },
        "index_size_pretty": { "type": "string" },
        "zero_scans_since_epoch": { "type": "number" },
        "zero_scans_since_time": { "type": "string" }
      }
    },
    "statsReset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stats_reset_epoch",
        "stats_reset_time",
        "days_since_reset",
        "postmaster_startup_epoch",
        "postmaster_startup_time"
      ],
      "properties": {
        "stats_reset_epoch": { "type": ["number", "null"] },
        "stats_reset_time": { "type": ["string", "null"] },
        "days_since_reset": { "type": ["integer", "null"] },
        "postmaster_startup_epoch": { "type": ["number", "null"] },
        "postmaster_startup_time": { "type": ["string", "null"] },
        "postmaster_startup_error": { "type": "string" }
      }
    },
    "dbEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unused_indexes",
        "total_count",
        "total_size_bytes",
        "total_size_pretty",
        "database_size_bytes",
        "database_size_pretty",
        "stats_reset"
      ],
      "properties": {
        "unused_indexes": { "type": "array", "items": { "$ref": "#/$defs/unusedIndex" } },
        "total_count": { "type": "integer" },
        "total_size_bytes": { "type": "number" },
        "total_size_pretty": { "type": "string" },
        "database_size_bytes": { "type": "number" },
        "database_size_pretty": { "type": "string" },
        "stats_reset": { "$ref": "#/$defs/statsReset" },
        "scan_window": { "$ref": "#/$defs/scanWindow" },
        "table_writes": { "type": "array", "items": { "$ref": "#/$defs/tableWrites" } }
      }
    },
    "scanWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_epoch", "start_time", "end_epoch", "end_time", "days", "lookback", "reading_step", "restart_in_window", "reset_in_window"],
      "properties": {
        "start_epoch": { "type": "number" },
        "start_time": { "type": "string" },
        "end_epoch": { "type": "number" },
        "end_time": { "type": "string" },
        "days": { "type": "number" },
        "lookback": { "type": "string" },
        "reading_step": { "type": "string" },
        "restart_in_window": { "type": ["boolean", "null"] },
        "reset_in_window": { "type": ["boolean", "null"] }
      }
    },
    "tableWrites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "table_name", "n_tup_upd", "n_tup_hot_upd", "n_tup_ins", "hot_share_pct", "window"],
      "properties": {
        "schema_name": { "type": "string" },
        "table_name": { "type": "string" },
        "n_tup_upd": { "type": ["integer", "null"] },
        "n_tup_hot_upd": { "type": ["integer", "null"] },
        "n_tup_ins": { "type": ["integer", "null"] },
        "hot_share_pct": { "type": ["number", "null"] },
        "window": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dbEntry" }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/$defs/data" },
        "postgres_version": { "$ref": "#/$defs/postgresVersion" }
      }
    }
  }
}
